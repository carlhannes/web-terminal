# ---- Terminal gateway (server/terminal-gateway.ts) ----
# The gateway is a SEPARATE Node process from the web app. Copy to .env.local
# (gitignored) for local dev, or set these in your deployment environment.

# Where the gateway listens (bind to localhost; put a reverse proxy in front for TLS).
GATEWAY_PORT=8081
GATEWAY_BIND=127.0.0.1

# The SSH host every login connects to (the box running sshd + tmux).
SSH_HOST=127.0.0.1
SSH_PORT=22

# Host-key pinning. REQUIRED in production (gateway refuses to start without it).
# In dev, if unset, any host key is accepted with a warning.
# SSH_KNOWN_HOSTS=/etc/ssh/ssh_known_hosts

# Allowed browser Origin(s) for /auth + WS upgrade (comma-separated). REQUIRED in
# production (anti-CSWSH). In dev, leave empty to allow.
# ALLOWED_ORIGIN=https://terminal.example.com

# Cookies marked Secure automatically in production; force with COOKIE_SECURE=true/false.
# COOKIE_SECURE=true

# Lifetimes / limits.
IDLE_TIMEOUT_MS=1800000
SESSION_TTL_MS=43200000
LIST_POLL_MS=2000
MAX_DESKTOPS_PER_USER=8
MAX_PANES_PER_USER=8
AUTH_RATE_MAX=5
AUTH_RATE_WINDOW_MS=900000

# Where per-user layout sidecar JSON files are stored (default ~/.web-terminal/layouts).
# LAYOUT_DIR=/var/lib/web-terminal/layouts

# tmux session name prefix -> sessions are named <prefix>-<user>-<n>.
SESSION_PREFIX=web

# ---- Web client (build-time, shipped to the browser; NO secrets) ----
# By default the client uses same-origin /ws and /auth (Vite proxy in dev, reverse
# proxy in prod). Only set these to point at a different gateway origin.
# VITE_TERMINAL_GATEWAY_WS_URL=wss://gw.example.com/ws
# VITE_TERMINAL_GATEWAY_HTTP_URL=https://gw.example.com
