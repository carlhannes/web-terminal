# The ssh2 + tmux WebSocket gateway. Same image as the app, different role/CMD.
[Unit]
Description=Web terminal ssh2+tmux gateway
After=network-online.target

[Container]
ContainerName=webterm-gateway
Image=localhost/webterm:latest
Network=webterm.network
Exec=npm run gateway:start
# Edit this file for SSH_HOST / ALLOWED_ORIGIN / SSH_KNOWN_HOSTS etc.
EnvironmentFile=%h/.config/webterm/gateway.env
# Persist per-user layout sidecars across restarts.
Volume=webterm-layouts:/var/lib/web-terminal/layouts
# Pin the target host's key (REQUIRED when NODE_ENV=production). Provide the file on the host.
Volume=%h/.config/webterm/known_hosts:/etc/webterm/known_hosts:ro,Z

[Service]
Restart=always

[Install]
WantedBy=default.target
