# Copy to ~/.config/webterm/gateway.env (rootless) or /etc/webterm/gateway.env (rootful)
# and edit. Referenced by webterm-gateway.container via EnvironmentFile.

# Bind all interfaces INSIDE the container so the proxy container can reach it.
# This is private: the container isn't published to the host, only the proxy is.
GATEWAY_BIND=0.0.0.0

# The host the gateway SSHes into. If sshd runs on the Podman host itself, use
# host.containers.internal (Podman maps it to the host); otherwise a real hostname/IP.
SSH_HOST=host.containers.internal
SSH_PORT=22

# Production hardening (gateway refuses to start in prod without host-key pinning).
NODE_ENV=production
SSH_KNOWN_HOSTS=/etc/webterm/known_hosts
COOKIE_SECURE=true

# Must match the public origin users hit (the proxy's domain).
ALLOWED_ORIGIN=https://terminal.example.com

# Where layout sidecars live inside the container (matches the Volume mount).
LAYOUT_DIR=/var/lib/web-terminal/layouts

# Optional tuning (defaults shown):
# GATEWAY_PORT=8081
# MAX_DESKTOPS_PER_USER=8
# MAX_PANES_PER_USER=8
