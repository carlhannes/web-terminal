# THROWAWAY test target: an sshd + tmux box to point the gateway at while developing.
# NOT for production — it ships a known demo password on purpose.
#   podman build -t webterm-sshd deploy/test-sshd
#   podman run -d --name webterm-sshd --network webterm webterm-sshd   # login: demo / demo
FROM docker.io/library/debian:stable-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssh-server tmux ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /run/sshd \
  && useradd -m -s /bin/bash demo \
  && echo 'demo:demo' | chpasswd \
  && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
  && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
